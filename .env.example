# No secrets are required to run scan/analyze/resolve/paper - the pipeline
# runs identically without any of these set.

# Optional: Telegram notifications for paper trading (requirement #20).
# Set both to enable; leave both unset/empty to keep notifications off (the
# default - notify_paper_trading_events() silently no-ops). Create a bot
# via @BotFather to get TELEGRAM_BOT_TOKEN; TELEGRAM_CHAT_ID is your own
# chat id, found by messaging your bot once and checking
# https://api.telegram.org/bot<token>/getUpdates.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Placeholder for a future stage (not built yet):
# LLM_API_KEY=

# Optional overrides available now:
# LOG_LEVEL=INFO
# DB_PATH=data/polymarket.db
